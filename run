"""
DVM Management - Standalone executable wrapper (auto-detect mode)
Run directly without pip install: ./run
"""
import sys
import os
from pathlib import Path

# Add the dvm_mgmt package to Python path
script_dir = Path(__file__).parent.absolute()
if str(script_dir) not in sys.path:
    sys.path.insert(0, str(script_dir))

# Import and run main
from dvm_mgmt.__main__ import main

if __name__ == '__main__':
    sys.exit(main())
